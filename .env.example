# ─────────────────────────────────────────────
#  NEXUS — пример конфигурации
#  Скопируйте файл:  cp .env.example .env
#  Никогда не коммитьте реальный .env
# ─────────────────────────────────────────────

# ── Telegram ────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AA-ZZZ-your-telegram-bot-token
# Публичный HTTPS-адрес мини-приложения (ngrok / домен)
WEBAPP_URL=https://your-domain.example
# Username бота без @ (используется в реферальных ссылках)
BOT_USERNAME=your_bot
# Канал для бонуса за подписку (необязательно), например @nexus_channel
SUBSCRIPTION_CHANNEL=

# ── База данных ─────────────────────────────
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public

# ── Безопасность ────────────────────────────
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
# initData считается просроченным через N секунд
TELEGRAM_AUTH_TTL=86400
# Разрешить вход без Telegram (ТОЛЬКО для локальной разработки)
ALLOW_DEV_AUTH=true

# ── Администрирование ───────────────────────
# Telegram ID администраторов через запятую
ADMIN_TELEGRAM_ID=123456789
# Общий секрет между ботом и API (openssl rand -hex 24)
INTERNAL_API_TOKEN=change_me_internal_token
# Адрес API, к которому обращается бот
API_URL=http://localhost:4000

# ── Сервер ──────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Разрешённые Origin для CORS через запятую
CORS_ORIGIN=http://localhost:5173

# ── Платежи ─────────────────────────────────
# mock | telegram
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=change_me_payment_webhook_secret
# Provider token от @BotFather (нужен для PAYMENT_PROVIDER=telegram)
TELEGRAM_PROVIDER_TOKEN=
# Курс: сколько монет B даётся за 1 единицу валюты платежа
COINS_PER_CURRENCY_UNIT=1
PAYMENT_CURRENCY=RUB

# ── Игровая экономика ───────────────────────
START_BONUS=250
REFERRER_BONUS=150
REFEREE_BONUS=100
DAILY_BONUS_BASE=50
WITHDRAWAL_MIN=1000
WITHDRAWAL_FEE_PERCENT=5
BIG_WIN_THRESHOLD=1000

# ── Frontend (Vite) ─────────────────────────
# Базовый адрес API для web-клиента
VITE_API_URL=http://localhost:4000
# ID для входа в dev-режиме без Telegram
VITE_DEV_TELEGRAM_ID=123456789
